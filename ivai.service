[Unit]
Description=Ivai OS Autonomous Agent
After=network.target

[Service]
Type=simple
User=ivai
Group=ivai
WorkingDirectory=/etc/ivai
Environment=IVAI_PORT=8080
ExecStart=/usr/local/bin/ivai-os
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
